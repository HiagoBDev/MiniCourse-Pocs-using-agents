# Porta HTTP do backend
PORT=3333

# SQLite — caminho relativo à pasta backend/ (igual no Docker, onde backend/ vira /app)
DATABASE_URL="file:./prisma/data/dev.db"

# Chaves das APIs externas. Ficam SOMENTE no backend.
# Chave inválida/ausente não derruba o servidor: a triagem fica PARCIAL ou FALHA.
GEMINI_API_KEY="your-gemini-api-key"
JEV_API_KEY="your-jev-api-key"

# Modelo do Gemini usado no resumo (opcional)
GEMINI_MODEL="gemini-3.8-flash"
